# Configuración de la API Login
# Copia este archivo como .env y ajusta los valores según tu entorno

# Clave para endpoints admin (header Admin-Key)
ADMIN_KEY=my_very_secret_key

# Clave para firmar cookies de sesión y JWT (debe ser diferente de ADMIN_KEY)
# Genera una clave segura: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here

# Ruta de la base de datos (en Docker usar ruta absoluta)
DATABASE_PATH=/api_login/app/database

# Configuración de sesiones (solo en producción con HTTPS)
# SESSION_COOKIE_SECURE=true  # Descomenta si usas HTTPS
